// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/debian
{
  "name": "Debian",
  // Or use a Dockerfile or Docker Compose file. More info: https://containers.dev/guide/dockerfile
  "image": "mcr.microsoft.com/devcontainers/base:trixie",

  // Features to add to the dev container. More info: https://containers.dev/features.
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": 24
    },
    "ghcr.io/devcontainers/features/java:1": {
      "version": "27.0.0-amzn",
      "jdkDistro": "amzn",
      "additionalVersions": "25.0.4-amzn",
      "installMaven": "true",
      "mavenVersion": "latest"
    },
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/anthropics/devcontainer-features/claude-code:1.0": {}
  },

  // Use 'forwardPorts' to make a list of ports inside the container available locally.
  "forwardPorts": [3000, 35729],

  "mounts": [
    "type=volume,source=claude-code-config,target=/home/vscode/.claude",
    "type=volume,source=gh-config,target=/home/vscode/.config/gh"
  ],

  // Configure tool-specific properties.
  "customizations": {
    "vscode": {
      "settings": {
        "git.enableCommitSigning": true,
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "markdown.preview.breaks": true,
        "workbench.editorAssociations": {
          "*.drawio.png": "hediet.vscode-drawio"
        },
        "hediet.vscode-drawio.offline": false,
        "hediet.vscode-drawio.theme": "kennedy",
        "java.checkstyle.configuration": "/google_checks.xml",
        "java.format.settings.url": "https://raw.githubusercontent.com/google/styleguide/gh-pages/eclipse-java-google-style.xml",
        "java.format.settings.profile": "GoogleStyle",
        "java.format.comments.enabled": false,
        "[java]": {
          "editor.defaultFormatter": "redhat.java"
        },
        "java.checkstyle.version": "14.1.0"
      },
      "extensions": [
        "EditorConfig.EditorConfig",
        "esbenp.prettier-vscode",
        "DavidAnson.vscode-markdownlint",
        "3w36zj6.textlint",
        "streetsidesoftware.code-spell-checker",
        "hediet.vscode-drawio",
        "vscjava.vscode-java-pack",
        "shengchen.vscode-checkstyle"
      ]
    }
  },

  // A command to run when creating the container. This command is run after "initializeCommand" and before "updateContentCommand".
  "onCreateCommand": "/bin/bash .devcontainer/scripts/install.sh",

  // Uncomment to connect as root instead. More info: https://aka.ms/dev-containers-non-root.
  // "remoteUser": "root"

  "containerEnv": {
    "CLAUDE_CONFIG_DIR": "/home/vscode/.claude"
  }
}

<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_1" name="備品の購入申請" processRef="Process_1" />
  </bpmn:collaboration>
  <bpmn:process id="Process_1">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_Requester" name="申請者">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Register</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_RequestSent</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_RejectReceived</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Rejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_OrderedReceived</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Done</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Approver" name="承認者">
        <bpmn:flowNodeRef>Event_RequestReceived</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Approve</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_RejectSent</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Purchasing" name="購買担当">
        <bpmn:flowNodeRef>Task_Order</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_OrderedSent</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_1" name="開始">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_Register" name="購入申請を&#10;登録">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:intermediateCatchEvent id="Event_RequestSent" name="申請通知送信">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_1" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateThrowEvent id="Event_RequestReceived" name="申請通知受信">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_2" />
    </bpmn:intermediateThrowEvent>
    <bpmn:userTask id="Task_Review" name="申請内容を&#10;確認">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_Approve" name="承認する？">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_No</bpmn:outgoing>
      <bpmn:outgoing>Flow_Yes</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:intermediateThrowEvent id="Event_RejectSent" name="却下通知送信">
      <bpmn:incoming>Flow_No</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_3" />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateCatchEvent id="Event_RejectReceived" name="却下通知受信">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_4" />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="End_Rejected" name="却下">
      <bpmn:incoming>Flow_7</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="Task_Order" name="発注を実施">
      <bpmn:incoming>Flow_Yes</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:intermediateThrowEvent id="Event_OrderedSent" name="発注完了通知送信">
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_5" />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateCatchEvent id="Event_OrderedReceived" name="発注完了通知受信">
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_6" />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="End_Done" name="購入完了">
      <bpmn:incoming>Flow_10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="Task_Register" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_Register" targetRef="Event_RequestSent" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Event_RequestSent" targetRef="Event_RequestReceived" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Event_RequestReceived" targetRef="Task_Review" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Task_Review" targetRef="Gateway_Approve" />
    <bpmn:sequenceFlow id="Flow_No" name="NO" sourceRef="Gateway_Approve" targetRef="Event_RejectSent" />
    <bpmn:sequenceFlow id="Flow_Yes" name="YES" sourceRef="Gateway_Approve" targetRef="Task_Order" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Event_RejectSent" targetRef="Event_RejectReceived" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Event_RejectReceived" targetRef="End_Rejected" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Task_Order" targetRef="Event_OrderedSent" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Event_OrderedSent" targetRef="Event_OrderedReceived" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Event_OrderedReceived" targetRef="End_Done" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_1">
      <bpmndi:BPMNShape id="Participant_1_di" bpmnElement="Participant_1" isHorizontal="true">
        <dc:Bounds x="0" y="0" width="1100" height="360" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Requester_di" bpmnElement="Lane_Requester" isHorizontal="true">
        <dc:Bounds x="30" y="0" width="1070" height="120" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Approver_di" bpmnElement="Lane_Approver" isHorizontal="true">
        <dc:Bounds x="30" y="120" width="1070" height="120" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Purchasing_di" bpmnElement="Lane_Purchasing" isHorizontal="true">
        <dc:Bounds x="30" y="240" width="1070" height="120" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="StartEvent_1_di" bpmnElement="StartEvent_1">
        <dc:Bounds x="72" y="42" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="79" y="85" width="22" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Register_di" bpmnElement="Task_Register">
        <dc:Bounds x="160" y="20" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Event_RequestSent_di" bpmnElement="Event_RequestSent">
        <dc:Bounds x="320" y="42" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="303" y="18" width="70" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Event_RequestReceived_di" bpmnElement="Event_RequestReceived">
        <dc:Bounds x="320" y="162" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="303" y="205" width="70" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Review_di" bpmnElement="Task_Review">
        <dc:Bounds x="416" y="140" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Approve_di" bpmnElement="Gateway_Approve" isMarkerVisible="true">
        <dc:Bounds x="576" y="155" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="571" y="131" width="60" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Event_RejectSent_di" bpmnElement="Event_RejectSent">
        <dc:Bounds x="686" y="162" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="669" y="205" width="70" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Event_RejectReceived_di" bpmnElement="Event_RejectReceived">
        <dc:Bounds x="686" y="42" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="669" y="18" width="70" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Rejected_di" bpmnElement="End_Rejected">
        <dc:Bounds x="782" y="42" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="789" y="85" width="22" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Order_di" bpmnElement="Task_Order">
        <dc:Bounds x="686" y="260" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Event_OrderedSent_di" bpmnElement="Event_OrderedSent">
        <dc:Bounds x="846" y="282" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="820" y="325" width="90" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Event_OrderedReceived_di" bpmnElement="Event_OrderedReceived">
        <dc:Bounds x="906" y="42" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="880" y="18" width="90" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Done_di" bpmnElement="End_Done">
        <dc:Bounds x="1002" y="42" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="998" y="85" width="44" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1">
        <di:waypoint x="108" y="60" />
        <di:waypoint x="160" y="60" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2">
        <di:waypoint x="260" y="60" />
        <di:waypoint x="320" y="60" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3">
        <di:waypoint x="338" y="78" />
        <di:waypoint x="338" y="162" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_4_di" bpmnElement="Flow_4">
        <di:waypoint x="356" y="180" />
        <di:waypoint x="416" y="180" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_5_di" bpmnElement="Flow_5">
        <di:waypoint x="516" y="180" />
        <di:waypoint x="576" y="180" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_No_di" bpmnElement="Flow_No">
        <di:waypoint x="626" y="180" />
        <di:waypoint x="686" y="180" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="647" y="162" width="18" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Yes_di" bpmnElement="Flow_Yes">
        <di:waypoint x="601" y="205" />
        <di:waypoint x="601" y="300" />
        <di:waypoint x="686" y="300" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="606" y="240" width="22" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_6_di" bpmnElement="Flow_6">
        <di:waypoint x="704" y="162" />
        <di:waypoint x="704" y="78" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_7_di" bpmnElement="Flow_7">
        <di:waypoint x="722" y="60" />
        <di:waypoint x="782" y="60" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_8_di" bpmnElement="Flow_8">
        <di:waypoint x="786" y="300" />
        <di:waypoint x="846" y="300" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_9_di" bpmnElement="Flow_9">
        <di:waypoint x="864" y="282" />
        <di:waypoint x="864" y="60" />
        <di:waypoint x="906" y="60" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_10_di" bpmnElement="Flow_10">
        <di:waypoint x="942" y="60" />
        <di:waypoint x="1002" y="60" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>

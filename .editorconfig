root = true

[*]
charset = utf-8
indent_style = space
trim_trailing_whitespace = true
insert_final_newline = true
end_of_line = lf

[*.{md, markdown}]
trim_trailing_whitespace = false

# Redistributed verbatim under the IPA Font License; must not be re-encoded.
[docs/fonts/**]
charset = unset
trim_trailing_whitespace = unset
insert_final_newline = unset
